{
  "rules": {
    ".read": false,
    ".write": false,

    "roomIndex": {
      ".read": "auth != null",
      ".indexOn": ".value",
      "$code": {
        ".write": "auth != null && ((!data.exists() && newData.exists()) || (data.exists() && !newData.exists() && data.val() < now - 86400000))",
        ".validate": "newData.isNumber() && newData.val() <= now && $code.matches(/^[A-HJKMNP-Z2-9]{4}$/)"
      }
    },

    "rooms": {
      "$code": {
        ".read": "auth != null",
        ".write": "auth != null && data.exists() && !newData.exists() && data.child('meta/createdAt').val() < now - 86400000",

        "meta": {
          ".write": "auth != null && ((!data.exists() && newData.child('hostId').val() === auth.uid) || (data.exists() && data.child('hostId').val() === auth.uid))",
          ".validate": "newData.hasChildren(['hostId', 'createdAt', 'status', 'round', 'cardsPerPlayer'])",
          "hostId": { ".validate": "newData.isString() && (!data.exists() || newData.val() === data.val())" },
          "createdAt": { ".validate": "newData.isNumber() && (!data.exists() || newData.val() === data.val())" },
          "status": { ".validate": "newData.val() === 'lobby' || newData.val() === 'playing' || newData.val() === 'over'" },
          "round": { ".validate": "newData.isNumber() && newData.val() >= 1" },
          "cardsPerPlayer": { ".validate": "newData.isNumber() && newData.val() >= 1 && newData.val() <= 8" },
          "$other": { ".validate": false }
        },

        "game": {
          ".write": "auth != null && root.child('rooms').child($code).child('meta/hostId').val() === auth.uid",
          "calls": {
            "$call": {
              ".validate": "!data.exists() && $call.matches(/^c([0-9]|[1-6][0-9]|7[0-4])$/) && newData.hasChildren(['n', 'i', 'at'])",
              "n": { ".validate": "newData.isNumber() && newData.val() >= 1 && newData.val() <= 75" },
              "i": { ".validate": "newData.isNumber() && 'c' + newData.val() === $call" },
              "at": { ".validate": "newData.isNumber()" },
              "$other": { ".validate": false }
            }
          }
        },

        "marks": {
          "$uid": {
            ".write": "auth != null && ((auth.uid === $uid && root.child('rooms').child($code).child('meta/status').val() === 'playing') || (!newData.exists() && root.child('rooms').child($code).child('meta/hostId').val() === auth.uid))",
            "$cardId": {
              ".validate": "root.child('rooms').child($code).child('claims').child($cardId).val() === $uid",
              "$cell": {
                ".validate": "$cell.matches(/^c([0-9]|1[0-9]|2[0-4])$/) && newData.hasChildren(['x', 'y'])",
                "x": { ".validate": "newData.isNumber() && newData.val() >= -0.14 && newData.val() <= 0.14" },
                "y": { ".validate": "newData.isNumber() && newData.val() >= -0.14 && newData.val() <= 0.14" },
                "$other": { ".validate": false }
              }
            }
          }
        },

        "players": {
          "$uid": {
            ".write": "auth != null && ((auth.uid === $uid && (data.exists() || newData.parent().parent().child('meta/status').val() === 'lobby')) || (!newData.exists() && root.child('rooms').child($code).child('meta/hostId').val() === auth.uid))",
            ".validate": "newData.hasChildren(['name', 'joinedAt'])",
            "name": { ".validate": "newData.isString() && newData.val().length >= 1 && newData.val().length <= 16 && (newData.val() === data.val() || root.child('rooms').child($code).child('meta/status').val() !== 'playing')" },
            "avatarId": { ".validate": "newData.isString() && newData.val().length <= 48 && (newData.val() === data.val() || root.child('rooms').child($code).child('meta/status').val() !== 'playing')" },
            "color": { ".validate": "newData.isString() && newData.val().matches(/^#[0-9a-fA-F]{6}$/)" },
            "mode": { ".validate": "newData.val() === 'beginner' || newData.val() === 'pro'" },
            "joinedAt": { ".validate": "newData.isNumber()" },
            "online": { ".validate": "newData.isBoolean()" },
            "lastSeen": { ".validate": "newData.isNumber()" }
          }
        },

        "picks": {
          "$uid": {
            ".write": "auth != null && root.child('rooms').child($code).child('meta/status').val() === 'lobby' && (auth.uid === $uid || (!newData.exists() && root.child('rooms').child($code).child('meta/hostId').val() === auth.uid))",
            "$slot": {
              ".validate": "$slot.matches(/^s[0-7]$/) && newData.hasChildren(['cardId', 'round']) && root.child('rooms').child($code).child('claims').child(newData.child('cardId').val() + '').val() === $uid",
              "cardId": { ".validate": "newData.isNumber() && newData.val() >= 1 && newData.val() <= 3003" },
              "round": { ".validate": "newData.isNumber() && newData.val() >= 1 && newData.val() <= root.child('rooms').child($code).child('meta/round').val()" },
              "$other": { ".validate": false }
            }
          }
        },

        "claims": {
          "$cardId": {
            ".write": "auth != null && root.child('rooms').child($code).child('meta/status').val() === 'lobby' && ((newData.val() === auth.uid && (!data.exists() || data.val() === auth.uid)) || (!newData.exists() && (data.val() === auth.uid || root.child('rooms').child($code).child('meta/hostId').val() === auth.uid)))",
            ".validate": "newData.isString() && $cardId.matches(/^[0-9]{1,4}$/) && root.child('rooms').child($code).child('players').child(newData.val()).exists()"
          }
        }
      }
    }
  }
}
